    "stored": {
      "modelMap": {
        "opus": [
          {
            "provider": "a",
            "model": "m1"
          },
          {
            "provider": "b",
            "model": "gone"
          },
          {
            "provider": "c",
            "model": "m3"
          }
        ]
      }
    },
    "models": {
      "a": {
        "models": {
          "m1": {
            "name": "One"
          }
        }
      },
      "b": {
        "models": {
          "other": {
            "name": "Other"
          }
        }
      },
      "c": {
        "models": {
          "m3": {
            "name": "Three"
          }
        }
      }
    }
  },
  "result": {
