        }
      ],
      "sonnet": [],
      "haiku": [],
      "fable": [],
      "default": [
        {
          "provider": "a",
          "model": "m1",
          "name": "One",
          "derived": true
        },
        {
          "provider": "c",
          "model": "m3",
          "name": "Three",
          "derived": true
        }
      ]
