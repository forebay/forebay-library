{
  "source": "an application declaring only tierModel gets the tier model variables and no name or default-model variable",
  "function": "environment",
  "argument": {
    "map": {
      "opus": [
        {
          "provider": "p",
          "model": "m-opus",
          "name": "Opus",
          "derived": false
        }
      ],
      "default": [
        {
          "provider": "p",
          "model": "m-opus",
          "name": "Opus",
          "derived": false
        }
      ]
    },
    "port": 4000,
    "providersEnabled": true,
    "userHome": "/nowhere",
    "application": {
      "baseUrlVariable": "WHERE",
      "placeholder": {
        "variable": "TICKET",
        "value": "nothing"
      },
      "ownLogin": {
        "variables": [
          "LOGIN_ONE"
        ]
      },
      "modelVariables": {
        "tierModel": "ZED_{{TIER}}_MODEL"
      }
    },
    "environment": {}
  },
  "result": {
    "environment": {
      "WHERE": "http://127.0.0.1:4000",
      "ZED_OPUS_MODEL": "m-opus",
      "TICKET": "nothing"
    }
  }
}
