{
  "source": "ModelMap.modelEnvPairs",
  "function": "environment",
  "argument": {
    "profile": {
      "defaultContext": 200000,
      "defaultOutput": 64000,
      "upstream": "http://127.0.0.1:1",
      "tierSourceProvider": "antigravity",
      "tierOrder": [
        "opus",
        "sonnet",
        "haiku",
        "fable"
      ],
      "tierFallback": [
        "opus",
        "sonnet",
        "haiku",
        "fable"
      ],
      "tierRegex": "^acme-([a-z]+)-\\d",
      "envPrefix": "OPENCODE",
      "nativeModelPattern": null
    },
    "map": {
      "sonnet": [
        {
          "provider": "p",
          "model": "s-1",
          "derived": false
        }
      ],
      "default": []
    },
    "port": 40001,
    "providersEnabled": true,
    "environment": {},
    "userHome": "/routing-test-home-that-does-not-exist",
    "application": {
      "baseUrlVariable": "ACME_BASE_URL",
      "placeholder": {
        "variable": "ACME_AUTH_TOKEN",
        "value": "acme-placeholder"
      },
      "ownLogin": {
        "variables": [
          "ACME_API_KEY",
          "ACME_OAUTH_TOKEN"
        ],
        "stateFile": {
          "directoryVariable": "ACME_CONFIG_DIR",
          "name": ".acme.json",
          "member": "account"
        }
      },
      "modelVariables": {
        "tierModel": "OPENCODE_DEFAULT_{{TIER}}_MODEL",
        "tierModelName": "OPENCODE_DEFAULT_{{TIER}}_MODEL_NAME",
        "model": "OPENCODE_MODEL"
      }
    }
  },
  "result": {
    "environment": {
      "ACME_BASE_URL": "http://127.0.0.1:40001",
      "OPENCODE_DEFAULT_SONNET_MODEL": "s-1",
      "OPENCODE_DEFAULT_SONNET_MODEL_NAME": "s-1",
      "ACME_AUTH_TOKEN": "acme-placeholder"
    }
  }
}
