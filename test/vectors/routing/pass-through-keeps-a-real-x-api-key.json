{
  "source": "opencode-proxy task 7: an x-api-key that is not the placeholder is the user's own key and is forwarded",
  "function": "passThrough",
  "argument": {
    "upstream": "https://api.example.test/v1/",
    "url": "/messages",
    "headers": {
      "x-api-key": "sk-real"
    },
    "bodyLength": 12,
    "placeholderAuthorization": "Bearer placeholder",
    "placeholderKeyHeaders": [
      "x-api-key"
    ]
  },
  "result": {
    "target": "https://api.example.test/v1/messages",
    "headers": {
      "x-api-key": "sk-real",
      "host": "api.example.test",
      "content-length": "12"
    }
  }
}
