{
  "source": "decision 7: own login",
  "function": "environment",
  "argument": {
    "profile": {
      "defaultContext": 200000,
      "defaultOutput": 64000,
      "upstream": "http://127.0.0.1:1",
      "tierSourceProvider": "antigravity",
      "tierOrder": [
        "opus",
        "sonnet",
        "haiku",
        "fable"
      ],
      "tierFallback": [
        "opus",
        "sonnet",
        "haiku",
        "fable"
      ],
      "tierRegex": "^acme-([a-z]+)-\\d",
      "envPrefix": "ACME",
      "nativeModelPattern": null
    },
    "map": {
      "opus": [
        {
          "provider": "antigravity",
          "model": "m-opus",
          "name": "M Opus",
          "derived": false
        }
      ],
      "sonnet": [],
      "haiku": [],
      "fable": [],
      "default": [
        {
          "provider": "antigravity",
          "model": "m-opus",
          "name": "M Opus",
          "derived": true
        }
      ]
    },
    "port": 40001,
    "providersEnabled": true,
    "environment": {
      "ACME_AUTH_TOKEN": "my-own-token"
    },
    "userHome": "/routing-test-home-that-does-not-exist",
    "application": {
      "baseUrlVariable": "ACME_BASE_URL",
      "placeholder": {
        "variable": "ACME_AUTH_TOKEN",
        "value": "acme-placeholder"
      },
      "ownLogin": {
        "variables": [
          "ACME_API_KEY",
          "ACME_OAUTH_TOKEN"
        ],
        "stateFile": {
          "directoryVariable": "ACME_CONFIG_DIR",
          "name": ".acme.json",
          "member": "account"
        }
      }
    }
  },
  "result": {
    "environment": {
      "ACME_BASE_URL": "http://127.0.0.1:40001",
      "ACME_DEFAULT_OPUS_MODEL": "m-opus",
      "ACME_DEFAULT_OPUS_MODEL_NAME": "M Opus",
      "ACME_MODEL": "m-opus"
    }
  }
}
