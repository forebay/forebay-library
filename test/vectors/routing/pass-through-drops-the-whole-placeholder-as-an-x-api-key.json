{
  "source": "opencode-proxy task 7: the AI SDK sends the whole placeholder authorization as its x-api-key, which never goes upstream",
  "function": "passThrough",
  "argument": {
    "upstream": "https://api.example.test/v1/",
    "url": "/messages",
    "headers": {
      "x-api-key": "Bearer placeholder",
      "accept": "application/json"
    },
    "bodyLength": 12,
    "placeholderAuthorization": "Bearer placeholder",
    "placeholderKeyHeaders": [
      "x-api-key"
    ]
  },
  "result": {
    "target": "https://api.example.test/v1/messages",
    "headers": {
      "accept": "application/json",
      "host": "api.example.test",
      "content-length": "12"
    }
  }
}
